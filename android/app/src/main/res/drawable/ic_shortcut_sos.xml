<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press shortcut «SOS»: adaptive, so the launcher masks it like the app icon.
     Sober on purpose (A36 §11 rule 7): ivory lifebuoy on «Ночь», no gold, no glow; red stays for flags. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/hot_night" />
    <foreground android:drawable="@drawable/ic_shortcut_sos_foreground" />
    <monochrome android:drawable="@drawable/ic_shortcut_sos_foreground" />
</adaptive-icon>
